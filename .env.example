# 서버 배포용 환경변수 예시. 복사해서 .env 로 만들고 값을 채우세요.
# .env 는 .gitignore 에 있으니 절대 커밋하지 마세요.

# ---------------------------------------------------------------------------
# 접속 비밀번호 — 외부에 열 때 반드시 설정
# ---------------------------------------------------------------------------
PADDY_WEB_PASSWORD=

# ---------------------------------------------------------------------------
# Copernicus (Sentinel-1) — 서버 전용 서비스 계정을 쓰세요
#
# 개인 계정 토큰을 서버에 올리지 마세요. CDSE 대시보드에서
# M2M(machine-to-machine) 클라이언트를 만들어 아래 값을 받습니다.
#   https://dataspace.copernicus.eu  →  계정 설정  →  Sentinel Hub  →  OAuth clients
# ---------------------------------------------------------------------------
OPENEO_AUTH_METHOD=client_credentials
OPENEO_AUTH_CLIENT_ID=
OPENEO_AUTH_CLIENT_SECRET=
OPENEO_AUTH_PROVIDER_ID=CDSE

# ---------------------------------------------------------------------------
# NASA Earthdata (NISAR) — 선택. 없으면 NISAR 교차검증만 비활성화됩니다.
# NASA 는 서비스 계정을 따로 제공하지 않으므로, 이 서비스 전용 계정을
# 새로 만들어 쓰는 것을 권합니다.
# ---------------------------------------------------------------------------
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ---------------------------------------------------------------------------
# 남용 방지 상한
# ---------------------------------------------------------------------------
PADDY_RATE_PER_HOUR=20      # IP 당 시간당 분석 요청 (0 = 무제한)
PADDY_MAX_PLOTS=50          # 일괄 분석 1회 최대 필지 수
PADDY_MAX_CONCURRENT=2      # IP 당 동시 실행 작업 수
